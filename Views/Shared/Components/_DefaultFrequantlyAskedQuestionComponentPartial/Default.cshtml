<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">

<style>
 
    :root {
        --navy: #0d1b3e;
        --navy-mid: #1b2f5e;
        --amber: #f5c518;
        --amber-deep: #d4a80e;
        --amber-soft: rgba(245,197,24,.12);
        --amber-border: rgba(245,197,24,.28);
        --bg: #f3f5f9;
        --white: #ffffff;
        --text-body: #5a6a8a;
        --text-muted: #8a96b0;
        --border: rgba(13,27,62,.08);
        --border-open: rgba(13,27,62,.13);
        --radius-lg: 20px;
        --radius-md: 14px;
    }

   
    .faq-section {
        background: var(--bg);
        padding: 96px 0 104px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        position: relative;
        overflow: hidden;
    }

        .faq-section::before {
            content: '';
            position: absolute;
            width: 520px;
            height: 520px;
            border-radius: 50%;
            border: 1px solid rgba(13,27,62,.05);
            top: -180px;
            right: -160px;
            pointer-events: none;
        }

        .faq-section::after {
            content: '';
            position: absolute;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            border: 1px solid rgba(13,27,62,.04);
            bottom: -120px;
            left: -80px;
            pointer-events: none;
        }

   
        position: sticky;
        top: 80px;
        padding-right: 32px;
    }

    .faq-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .22em;
        text-transform: uppercase;
        color: var(--amber-deep);
        margin-bottom: 14px;
    }

        .faq-eyebrow::before {
            content: '';
            display: block;
            width: 22px;
            height: 2px;
            border-radius: 2px;
            background: var(--amber);
        }

    .faq-main-title {
        font-size: clamp(28px, 3vw, 40px);
        font-weight: 800;
        color: var(--navy);
        line-height: 1.18;
        letter-spacing: -.025em;
        margin: 0 0 16px;
    }

    .faq-desc {
        font-size: 14.5px;
        font-weight: 400;
        color: var(--text-body);
        line-height: 1.7;
        margin: 0 0 36px;
    }


    .faq-illus {
        background: linear-gradient(140deg, var(--navy) 0%, var(--navy-mid) 100%);
        border-radius: var(--radius-lg);
        padding: 32px 28px;
        position: relative;
        overflow: hidden;
    }

        .faq-illus::before {
            content: '';
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(245,197,24,.07);
            bottom: -60px;
            right: -40px;
        }

    .faq-illus-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: var(--amber-soft);
        border: 1px solid var(--amber-border);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
    }

        .faq-illus-icon i {
            font-size: 26px;
            color: var(--amber);
        }

    .faq-illus-title {
        font-size: 16px;
        font-weight: 700;
        color: #f0e8d0;
        margin-bottom: 8px;
    }

    .faq-illus-text {
        font-size: 13px;
        color: rgba(240,232,208,.55);
        line-height: 1.6;
        margin: 0 0 22px;
    }

    .faq-illus-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--amber);
        text-decoration: none;
        letter-spacing: .04em;
        transition: gap .22s ease;
    }

        .faq-illus-link i {
            transition: transform .22s ease;
        }

        .faq-illus-link:hover {
            gap: 12px;
            color: var(--amber);
        }

            .faq-illus-link:hover i {
                transform: translateX(3px);
            }

   
    .faq-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .faq-item {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(13,27,62,.05);
        transition: box-shadow .25s ease, border-color .25s ease;
    }

        .faq-item.open {
            border-color: var(--border-open);
            box-shadow: 0 8px 28px rgba(13,27,62,.11);
        }

   
    .faq-question {
        width: 100%;
        background: none;
        border: none;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        cursor: pointer;
        text-align: left;
        transition: background .2s ease;
    }

        .faq-question:hover {
            background: rgba(13,27,62,.025);
        }

    .faq-item.open .faq-question {
        background: rgba(13,27,62,.025);
    }

   .faq-num {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: var(--amber-soft);
        border: 1px solid var(--amber-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        color: var(--navy);
        transition: background .25s ease, border-color .25s ease;
    }

    .faq-item.open .faq-num {
        background: var(--amber);
        border-color: var(--amber-deep);
    }

    .faq-q-text {
        flex: 1;
        font-size: 14.5px;
        font-weight: 600;
        color: var(--navy);
        line-height: 1.4;
    }

    .faq-chevron {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1.5px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--white);
        transition: background .25s ease, border-color .25s ease, transform .35s cubic-bezier(.22,.68,0,1.2);
    }

        .faq-chevron i {
            font-size: 14px;
            color: var(--text-muted);
            transition: color .25s ease;
        }

    .faq-item.open .faq-chevron {
        background: var(--navy);
        border-color: var(--navy);
        transform: rotate(180deg);
    }

        .faq-item.open .faq-chevron i {
            color: var(--amber);
        }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height .42s cubic-bezier(.4,0,.2,1), padding .35s ease;
    }

    .faq-answer-inner {
        padding: 0 22px 22px 66px; 
        font-size: 14px;
        color: var(--text-body);
        line-height: 1.72;
        border-top: 1px solid var(--border);
        padding-top: 16px;
    }

    .faq-item.open .faq-answer {
        max-height: 200px;
    }

   
    .faq-item {
        opacity: 0;
        transform: translateY(16px);
        animation: faq-in .45s ease forwards;
    }

        .faq-item:nth-child(1) {
            animation-delay: .06s;
        }

        .faq-item:nth-child(2) {
            animation-delay: .12s;
        }

        .faq-item:nth-child(3) {
            animation-delay: .18s;
        }

        .faq-item:nth-child(4) {
            animation-delay: .24s;
        }

        .faq-item:nth-child(5) {
            animation-delay: .30s;
        }

        .faq-item:nth-child(6) {
            animation-delay: .36s;
        }

    @@keyframes faq-in {
        to

    {
        opacity: 1;
        transform: translateY(0);
    }

    }


    @@media (max-width: 991px) {
        .faq-left

    {
        position: static;
        padding-right: 0;
        margin-bottom: 40px;
    }

    }
</style>

<section class="faq-section">
    <div class="container" style="position:relative;z-index:1;">
        <div class="row">

            <div class="col-lg-4">
                <div class="faq-left">
                    <div class="faq-eyebrow">Yardım Mərkəzi</div>
                    <h2 class="faq-main-title">Tez-tez Verilən<br>Suallar</h2>
                    <p class="faq-desc">Uçuş rezervasiyası və səyahət xidmətləri haqqında ən çox maraq doğuran sualların cavablarını buradan tapa bilərsiniz.</p>

                    <div class="faq-illus">
                        <div class="faq-illus-icon">
                            <i class="bi bi-headset"></i>
                        </div>
                        <div class="faq-illus-title">Cavab tapa bilmədiniz?</div>
                        <p class="faq-illus-text">Dəstək komandamız sizə 7/24 kömək etməyə hazırdır.</p>
                        <a href="#" class="faq-illus-link">
                            Bizimlə əlaqə <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="faq-list" id="faq-list">

                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span class="faq-num">01</span>
                            <span class="faq-q-text">Uçuşuma əlavə baqajı necə əlavə edə bilərəm?</span>
                            <span class="faq-chevron"><i class="bi bi-chevron-down"></i></span>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Rezervasiya prosesi zamanı və ya rezervasiyanızı tamamladıqdan sonra <strong>"Əlavə Xidmətlər"</strong> bölməsindən baqaj satın ala bilərsiniz. Uçuşa 2 saat qalmış əlavə baqaj əlavə etmək imkanı bağlanır.
                            </div>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span class="faq-num">02</span>
                            <span class="faq-q-text">Onlayn qeydiyyat (check-in) prosesi nə vaxt başlayır?</span>
                            <span class="faq-chevron"><i class="bi bi-chevron-down"></i></span>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Onlayn qeydiyyat prosesi adətən uçuş vaxtından <strong>24 saat əvvəl</strong> başlayır və uçuşa bir neçə saat kalana qədər davam edir. Beynəlxalq uçuşlarda pasport məlumatlarınızı hazır saxlamanız tövsiyə olunur.
                            </div>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span class="faq-num">03</span>
                            <span class="faq-q-text">Oturacaq (yer) seçimi necə edilir?</span>
                            <span class="faq-chevron"><i class="bi bi-chevron-down"></i></span>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Rezervasiya zamanı yer seçimi edə bilər və ya rezervasiyadan sonra şəxsi kabinetinizdən yerinizi dəyişdirə bilərsiniz. Pəncərə kənarı, dəhliz və əlavə ayaq məsafəsi olan oturacaqlar üçün əlavə ödəniş tələb oluna bilər.
                            </div>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span class="faq-num">04</span>
                            <span class="faq-q-text">Uçuşumu dəyişdirə və ya ləğv edə bilərəmmi?</span>
                            <span class="faq-chevron"><i class="bi bi-chevron-down"></i></span>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Biletin növündən asılı olaraq uçuşun dəyişdirilməsi və ya ləğv edilməsi əməliyyatları mümkündür. Ətraflı məlumat üçün <strong>Rezervasiyanın İdarə Edilməsi</strong> səhifəsindən istifadə edə bilərsiniz. Çevik (esnek) bilet sahibləri ödənişsiz dəyişiklik hüququndan yararlana bilərlər.
                            </div>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span class="faq-num">05</span>
                            <span class="faq-q-text">Uçuşuma yemək (təam) seçimi əlavə edə bilərəmmi?</span>
                            <span class="faq-chevron"><i class="bi bi-chevron-down"></i></span>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Bəli. Rezervasiya zamanı və ya uçuşunuzdan əvvəl menyu seçimi əlavə edə bilərsiniz. Vegetarian, vegan, qlütensiz və uşaq menyusu kimi xüsusi pəhriz seçimləri də mövcuddur.
                            </div>
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            <span class="faq-num">06</span>
                            <span class="faq-q-text">Sürətli Keçid (Fast Track) xidməti nədir?</span>
                            <span class="faq-chevron"><i class="bi bi-chevron-down"></i></span>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-inner">
                                Sürətli Keçid xidməti sayəsində təhlükəsizlik və pasport nəzarəti məntəqələrindən <strong>daha sürətlə keçə bilərsiniz</strong>. Xüsusilə sıx mövsümlərdə vaxta qənaət etmək istəyən sərnişinlərə tövsiyə olunur.
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
<script>
    (function () {
      const items = document.querySelectorAll('#faq-list .faq-item');

      items.forEach(item => {
        const btn    = item.querySelector('.faq-question');
        const answer = item.querySelector('.faq-answer');

        btn.addEventListener('click', () => {
          const isOpen = item.classList.contains('open');


          items.forEach(i => {
            i.classList.remove('open');
            i.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
          });


          if (!isOpen) {
            item.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });
    })();
</script>