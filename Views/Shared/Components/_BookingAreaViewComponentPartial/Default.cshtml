                                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                                    Uçuşu Sorğula
                                </button>
                            </div>

                            <div class="air-status-cards">
                                <div class="air-status-card">
                                    <div class="air-status-card-dot"></div>
                                    <div>
                                        <div class="air-status-card-title">Status</div>
                                        <div class="air-status-card-value">Vaxtında</div>
                                    </div>
                                </div>
                                <div class="air-status-card">
                                    <div class="air-status-card-dot yellow"></div>
                                    <div>
                                        <div class="air-status-card-title">Qapı</div>
                                        <div class="air-status-card-value">—</div>
                                    </div>
                                </div>
                                <div class="air-status-card">
                                    <div class="air-status-card-dot"></div>
                                    <div>
                                        <div class="air-status-card-title">Təxmini Qalxış</div>
                                        <div class="air-status-card-value">—</div>
                                    </div>
                                </div>
                                <div class="air-status-card">
                                    <div class="air-status-card-dot"></div>
                                    <div>
                                        <div class="air-status-card-title">Təxmini Eniş</div>
