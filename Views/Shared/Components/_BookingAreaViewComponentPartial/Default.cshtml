@await Component.InvokeAsync("_BookingTagsComponentPartial")

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap');

    :root {
        --sky: #0057FF;
        --sky-dark: #0040CC;
        --sky-light: #E8F0FF;
        --gold: #F5A623;
        --surface: #FFFFFF;
        --surface-2: #F7F9FC;
        --border: #E4E9F2;
        --text: #0D1B3E;
        --text-muted: #6B7A99;
        --radius: 16px;
        --radius-sm: 10px;
        --shadow: 0 8px 40px rgba(0,87,255,0.10);
        --shadow-card: 0 2px 12px rgba(13,27,62,0.07);
    }

    .air-bk-widget {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: linear-gradient(135deg, #0D1B3E 0%, #1a2f6e 100%);
        border-radius: 28px;
        padding: 10px;
        box-shadow: 0 30px 80px rgba(0,20,80,0.25);
    }

    .air-bk-tabs {
        display: flex;
        gap: 4px;
        padding: 6px;
        background: rgba(255,255,255,0.07);
        border-radius: 18px;
        margin-bottom: 10px;
        flex-wrap: wrap;
    }

    .air-bk-tab-btn {
        flex: 1;
        min-width: 130px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 18px;
        border: none;
        background: transparent;
        border-radius: 13px;
        color: rgba(255,255,255,0.60);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all .25s ease;
        white-space: nowrap;
    }

        .air-bk-tab-btn svg {
            opacity: .7;
            flex-shrink: 0;
        }

        .air-bk-tab-btn:hover {
            background: rgba(255,255,255,0.10);
            color: #fff;
        }

        .air-bk-tab-btn.active {
            background: #fff;
            color: var(--sky);
            box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        }

            .air-bk-tab-btn.active svg {
                opacity: 1;
            }

    .air-bk-panel {
        background: var(--surface);
        border-radius: 20px;
        padding: 32px;
    }

    .air-bk-pane {
        display: none;
    }

        .air-bk-pane.active {
            display: block;
        }

    .air-trip-type-row {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
    }

    .air-trip-type-btn {
        padding: 8px 18px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
        background: var(--surface-2);
        cursor: pointer;
        transition: all .2s;
    }

        .air-trip-type-btn:hover {
            border-color: var(--sky);
            color: var(--sky);
            background: var(--sky-light);
        }

        .air-trip-type-btn.active {
            background: var(--sky);
            border-color: var(--sky);
            color: #fff;
        }

    .air-route-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 0;
        background: var(--surface-2);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: 16px;
        transition: border-color .2s;
    }

        .air-route-row:focus-within {
            border-color: var(--sky);
        }

    .air-airport-field {
        position: relative;
        flex: 1;
        padding: 14px 18px;
        cursor: pointer;
    }

        .air-airport-field:first-child {
            border-right: 1.5px solid var(--border);
        }

    .air-airport-field-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        margin-bottom: 4px;
    }

    .air-airport-field-input {
        width: 100%;
        border: none;
        background: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        outline: none;
    }

        .air-airport-field-input::placeholder {
            font-weight: 500;
            color: #BCC5D6;
        }

    .air-airport-field-sub {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    .air-swap-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        background: var(--surface-2);
        border: none;
        cursor: pointer;
        position: relative;
        z-index: 1;
        transition: background .2s;
    }

        .air-swap-btn:hover {
            background: var(--sky-light);
        }

        .air-swap-btn svg {
            color: var(--sky);
        }

    .air-dates-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
    }

    .air-date-field {
        background: var(--surface-2);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 18px;
        cursor: pointer;
        transition: border-color .2s, opacity .2s;
    }

        .air-date-field:focus-within {
            border-color: var(--sky);
        }

        .air-date-field.disabled {
            opacity: .4;
            pointer-events: none;
        }

    .air-date-field-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 4px;
    }

    .air-date-field-input {
        width: 100%;
        border: none;
        background: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: var(--text);
        outline: none;
        cursor: pointer;
    }

        .air-date-field-input::placeholder {
            color: #BCC5D6;
            font-weight: 500;
        }

    .air-bottom-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 24px;
    }

    .air-pax-trigger {
        background: var(--surface-2);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 18px;
        cursor: pointer;
        transition: border-color .2s;
        position: relative;
        user-select: none;
    }

        .air-pax-trigger:hover, .air-pax-trigger.open {
            border-color: var(--sky);
        }

    .air-pax-trigger-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .air-pax-trigger-value {
        font-size: 15px;
        font-weight: 600;
        color: var(--text);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .air-pax-trigger-value svg {
            color: var(--text-muted);
            transition: transform .2s;
        }

    .air-pax-trigger.open .air-pax-trigger-value svg {
        transform: rotate(180deg);
    }

    .air-pax-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        z-index: 100;
        padding: 20px;
        min-width: 300px;
    }

    .air-pax-trigger.open .air-pax-dropdown {
        display: block;
    }

    .air-pax-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
    }

        .air-pax-row:last-of-type {
            border-bottom: none;
        }

    .air-pax-info-title {
        font-weight: 600;
        font-size: 14px;
        color: var(--text);
    }

    .air-pax-info-sub {
        font-size: 12px;
        color: var(--text-muted);
    }

    .air-pax-counter {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .air-pax-counter-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1.5px solid var(--border);
        background: var(--surface-2);
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text);
        font-weight: 600;
        transition: all .2s;
    }

        .air-pax-counter-btn:hover {
            border-color: var(--sky);
            color: var(--sky);
            background: var(--sky-light);
        }

    .air-pax-counter-val {
        font-weight: 700;
        font-size: 16px;
        width: 20px;
        text-align: center;
    }

    .air-cabin-section {
        margin-top: 14px;
    }

    .air-cabin-section-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        margin-bottom: 10px;
    }

    .air-cabin-options {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .air-cabin-btn {
        padding: 7px 14px;
        border: 1.5px solid var(--border);
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        background: var(--surface-2);
        color: var(--text-muted);
        transition: all .2s;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

        .air-cabin-btn.active {
            background: var(--sky);
            border-color: var(--sky);
            color: #fff;
        }

    .air-pax-done-btn {
        width: 100%;
        margin-top: 14px;
        padding: 10px;
        background: var(--sky);
        color: #fff;
        border: none;
        border-radius: var(--radius-sm);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: background .2s;
    }

        .air-pax-done-btn:hover {
            background: var(--sky-dark);
        }

    .air-promo-field {
        background: var(--surface-2);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 18px;
        cursor: pointer;
        transition: border-color .2s;
    }

    .air-promo-field-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .air-promo-toggle {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .air-promo-toggle-link {
        font-size: 14px;
        font-weight: 600;
        color: var(--sky);
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .air-promo-input-wrap {
        display: none;
        margin-top: 8px;
    }

        .air-promo-input-wrap.open {
            display: block;
        }

    .air-promo-input {
        width: 100%;
        border: none;
        background: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        outline: none;
        letter-spacing: .12em;
    }

        .air-promo-input::placeholder {
            letter-spacing: 0;
            font-weight: 400;
            color: #BCC5D6;
        }


    .air-extras-row {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .air-extra-check {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        color: var(--text-muted);
        font-weight: 500;
        cursor: pointer;
        user-select: none;
    }

        .air-extra-check input[type=checkbox] {
            accent-color: var(--sky);
            width: 16px;
            height: 16px;
            cursor: pointer;
        }


    .air-search-btn {
        width: 100%;
        padding: 18px;
        background: linear-gradient(135deg, var(--sky) 0%, #3B82F6 100%);
        color: #fff;
        border: none;
        border-radius: var(--radius);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 17px;
        font-weight: 800;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        letter-spacing: .01em;
        box-shadow: 0 8px 24px rgba(0,87,255,0.30);
        transition: all .25s;
    }

        .air-search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px rgba(0,87,255,0.38);
        }

        .air-search-btn:active {
            transform: translateY(0);
        }


    .air-bk-section-title {
        font-family: 'Syne', sans-serif;
        font-size: 22px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 6px;
    }

    .air-bk-section-sub {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 24px;
    }


    .air-query-method-row {
        display: flex;
        gap: 8px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .air-query-method-btn {
        flex: 1;
        min-width: 140px;
        padding: 12px 16px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
        background: var(--surface-2);
        cursor: pointer;
        transition: all .2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .air-query-method-btn:hover {
            border-color: var(--sky);
            color: var(--sky);
            background: var(--sky-light);
        }

        .air-query-method-btn.active {
            border-color: var(--sky);
            background: var(--sky-light);
            color: var(--sky);
            font-weight: 700;
        }

        .air-query-method-btn svg {
            flex-shrink: 0;
        }

    .air-query-fields {
        display: none;
    }

        .air-query-fields.active {
            display: block;
        }

    .air-field-stack {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .air-input-field-wrap {
        background: var(--surface-2);
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 14px 18px;
        transition: border-color .2s;
    }

        .air-input-field-wrap:focus-within {
            border-color: var(--sky);
        }

    .air-input-field-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-muted);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .air-input-field {
        width: 100%;
        border: none;
        background: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 15px;
        font-weight: 600;
        color: var(--text);
        outline: none;
    }

        .air-input-field::placeholder {
            color: #BCC5D6;
            font-weight: 400;
        }

    .air-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .air-help-links {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .air-help-link {
        font-size: 12px;
        color: var(--text-muted);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: color .2s;
    }

        .air-help-link:hover {
            color: var(--sky);
        }

    .air-info-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 20px;
    }

    .air-info-card {
        background: var(--sky-light);
        border-radius: var(--radius-sm);
        padding: 14px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .air-info-card-icon {
        width: 36px;
        height: 36px;
        background: var(--sky);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #fff;
    }

    .air-info-card-title {
        font-size: 12px;
        font-weight: 700;
        color: var(--text);
    }

    .air-info-card-sub {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 2px;
    }


    .air-bk-notice {
        background: #FFF9EC;
        border: 1.5px solid #F5A623;
        border-radius: var(--radius-sm);
        padding: 12px 16px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #7A5000;
    }

        .air-bk-notice svg {
            color: var(--gold);
            flex-shrink: 0;
            margin-top: 1px;
        }


    .air-fs-method-row {
        display: flex;
        gap: 0;
        background: var(--surface-2);
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .air-fs-method-btn {
        flex: 1;
        padding: 12px;
        border: none;
        background: transparent;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
        cursor: pointer;
        transition: all .2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

        .air-fs-method-btn:not(:last-child) {
            border-right: 1.5px solid var(--border);
        }

        .air-fs-method-btn.active {
            background: var(--sky);
            color: #fff;
        }

    .air-status-cards {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-top: 20px;
    }

    .air-status-card {
        background: var(--surface-2);
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .air-status-card-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #22C55E;
        flex-shrink: 0;
        box-shadow: 0 0 0 3px rgba(34,197,94,0.20);
    }

        .air-status-card-dot.yellow {
            background: #F5A623;
            box-shadow: 0 0 0 3px rgba(245,166,35,0.20);
        }

    .air-status-card-title {
        font-size: 12px;
        color: var(--text-muted);
    }

    .air-status-card-value {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
    }

    @@media (max-width: 768px) {
        .air-bk-panel {
            padding: 20px 16px;
        }

        .air-bk-tab-btn {
            font-size: 12px;
            padding: 10px 12px;
        }

        .air-dates-row, .air-bottom-row, .air-two-col, .air-info-cards {
            grid-template-columns: 1fr;
        }

        .air-status-cards {
            grid-template-columns: 1fr 1fr;
        }

        .air-route-row {
            grid-template-columns: 1fr;
        }

        .air-swap-btn {
            width: 100%;
            height: 36px;
            border-top: 1.5px solid var(--border);
            border-bottom: 1.5px solid var(--border);
        }

        .air-airport-field:first-child {
            border-right: none;
            border-bottom: 1.5px solid var(--border);
        }

        .air-query-method-btn {
            min-width: 100%;
        }
    }
</style>

<div class="air-booking-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="air-bk-widget">
                    <div class="air-bk-tabs" id="bkTabs">
                        <button class="air-bk-tab-btn active" data-tab="search">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /></svg>
                            Uçuş Axtar
                        </button>
                        <button class="air-bk-tab-btn" data-tab="trips">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                            Səyahətlərim
                        </button>
                        <button class="air-bk-tab-btn" data-tab="checkin">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></svg>
                            Online Check-in
                        </button>
                        <button class="air-bk-tab-btn" data-tab="status">
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                            Uçuş Statusu
                        </button>
                    </div>

                    <div class="air-bk-panel">

                        <div class="air-bk-pane active" id="pane-search">

                            <div class="air-trip-type-row" id="tripTypeRow">
