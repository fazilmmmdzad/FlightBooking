                        </div>
                        <div class="activity-step" id="step-2">
                            <div class="activity-step-ico"><i class="bi bi-check-lg"></i></div>
                            <span>İstək Hazırlanır</span>
                        </div>
                        <div class="activity-step" id="step-3">
