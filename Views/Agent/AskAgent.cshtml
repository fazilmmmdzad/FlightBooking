        <footer class="page-footer">
            <div class="footer-left">
                <i class="bi bi-airplane-fill" style="color:var(--indigo);"></i>
                FlightBooking AI Səyahət Köməkçisi
                <span style="color:var(--slate-200);">·</span>
                <a href="#" class="footer-link">Məxfilik</a>
                <span style="color:var(--slate-200);">·</span>
                <a href="#" class="footer-link">Şərtlər</a>
            </div>
            <div class="footer-powered">
                <i class="bi bi-stars"></i>
                Llama-3.1-8b-instant dəstəkli
            </div>
        </footer>

    </div>
    <div class="toast-bar" id="toast">
        <i class="bi bi-info-circle-fill" style="color:var(--cyan);"></i>
        <span id="toastMsg"></span>
    </div>

    <script>
        const promptInput = document.getElementById('promptInput');
        const charCount   = document.getElementById('charCount');
        const sendBtn     = document.getElementById('sendBtn');
        const messagesEl  = document.getElementById('messages');
        const emptyEl     = document.getElementById('emptyState');
        let isLoading = false;

        promptInput.addEventListener('input', function () {
            const len = this.value.length;
            charCount.textContent = len + ' / 500';
            charCount.style.color = len > 450 ? '#dc2626' : 'var(--slate-400)';
            if (len > 500) this.value = this.value.substring(0, 500);
        });

        function insertChip(text) {
            promptInput.value = text + ' ';
            promptInput.focus();
            promptInput.dispatchEvent(new Event('input'));
        }

        function setPrompt(text) {
            promptInput.value = text.replace(/^"/, '').replace(/"$/, '').trim();
            promptInput.focus();
            promptInput.dispatchEvent(new Event('input'));
        }

        function handleKeydown(e) {
            if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                e.preventDefault();
                sendMessage();
            }
        }

        let toastTimer;
        function showToast(msg) {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').textContent = msg;
            t.style.opacity = '1'; t.style.transform = 'translateY(0)';
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                t.style.opacity = '0'; t.style.transform = 'translateY(8px)';
            }, 2800);
        }

        const steps = ['step-1','step-2','step-3','step-4','step-5'];
        let stepTimers = [];

        function showAgentActivity() {
            const panel = document.getElementById('agentActivity');
            panel.classList.add('visible');
            steps.forEach(id => {
                const el = document.getElementById(id);
                el.classList.remove('done','active');
            });
            document.getElementById('activityBadge').textContent = 'Emal edilir';

            const delays = [0, 300, 700, 1200, 0];
            steps.forEach((id, i) => {
                if (i === steps.length - 1) return;
                const t = setTimeout(() => {
                    if (i > 0) document.getElementById(steps[i-1]).classList.replace('active','done');
                    document.getElementById(id).classList.add('active');
                }, delays[i]);
                stepTimers.push(t);
            });
        }

        function completeAgentActivity() {
            stepTimers.forEach(clearTimeout); stepTimers = [];
            steps.forEach(id => {
                const el = document.getElementById(id);
                el.classList.remove('active');
                el.classList.add('done');
            });
            document.getElementById('activityBadge').textContent = 'Tamamlandı';
            document.getElementById('activityBadge').style.background = '#f0fdf4';
            document.getElementById('activityBadge').style.color = '#16a34a';
            document.getElementById('activityBadge').style.borderColor = '#bbf7d0';
        }

        function resetAgentActivity() {
            stepTimers.forEach(clearTimeout); stepTimers = [];
            const panel = document.getElementById('agentActivity');
            panel.classList.remove('visible');
            const badge = document.getElementById('activityBadge');
            badge.textContent = 'Emal edilir';
            badge.style.background = ''; badge.style.color = ''; badge.style.borderColor = '';
        }

        function addUserMessage(text) {
            const div = document.createElement('div');
            div.className = 'msg-user fade-in';
            div.innerHTML = `
                <div class="msg-avatar"><i class="bi bi-person-fill"></i></div>
                <div class="msg-bubble">${text.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>`;
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function showTypingIndicator() {
            const div = document.createElement('div');
            div.className = 'msg-ai fade-in';
            div.id = 'typingIndicator';
            div.innerHTML = `
                <div class="msg-avatar"><i class="bi bi-robot"></i></div>
                <div class="msg-typing">
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <span class="typing-text">AI düşünür...</span>
                </div>`;
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function removeTypingIndicator() {
            const el = document.getElementById('typingIndicator');
            if (el) el.remove();
        }

        function renderMarkdown(text) {
            let html = text
                .replace(/^### (.+)$/gm, '<h5 style="font-family:var(--font-display);font-size:13px;font-weight:700;margin:10px 0 4px">$1</h5>')
                .replace(/^## (.+)$/gm,  '<h4 style="font-family:var(--font-display);font-size:14px;font-weight:700;margin:12px 0 5px">$1</h4>')
                .replace(/^# (.+)$/gm,   '<h3 style="font-family:var(--font-display);font-size:15px;font-weight:800;margin:14px 0 6px">$1</h3>')
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/^---$/gm, '<hr style="border:none;border-top:1px solid var(--slate-200);margin:10px 0;">')
                .replace(/^[•\-\*] (.+)$/gm, '<li>$1</li>')
                .replace(/^\d+\. (.+)$/gm, '<li>$1</li>');

            html = html.replace(/(<li>.*?<\/li>\n?)+/gs, (match) => `<ul style="padding-left:18px;margin:6px 0;">${match}</ul>`);

            const lines = html.split('\n');
            const result = [];
            for (let i = 0; i < lines.length; i++) {
                const line = lines[i].trim();
                if (!line) { result.push(''); continue; }
                if (line.startsWith('<h') || line.startsWith('<ul') || line.startsWith('<hr')) {
                    result.push(line);
                } else {
                    result.push(`<p style="margin:0 0 6px;">${line}</p>`);
                }
            }
            return result.join('');
        }

                function updateWeatherPanel(weather) {
            document.getElementById('weatherEmptyState').style.display = 'none';
            document.getElementById('weatherContent').style.display = 'block';

            document.getElementById('weatherCity').textContent = weather.city || '';
            document.getElementById('weatherCountry').textContent = weather.country || '';
            document.getElementById('weatherTemp').textContent = (weather.temperature ?? '-') + '°C';
            document.getElementById('weatherCondition').textContent = weather.condition || '';
            document.getElementById('weatherIcon').innerHTML = `<i class="bi ${getWeatherIcon(weather.condition)}"></i>`;

            document.getElementById('weatherHumidity').textContent = (weather.humidity ?? '-') + '%';
            document.getElementById('weatherWind').textContent = (weather.windSpeed ?? '-') + ' km/s ' + (weather.windDirection || '');
            document.getElementById('weatherVisibility').textContent = (weather.visibility ?? '-') + ' km';
            document.getElementById('weatherPressure').textContent = (weather.pressure ?? '-') + ' hPa';
            document.getElementById('weatherSunrise').textContent = weather.sunrise || '-';
            document.getElementById('weatherSunset').textContent = weather.sunset || '-';

            const forecastEl = document.getElementById('weatherForecast');
            forecastEl.innerHTML = '';

            if (Array.isArray(weather.forecasts)) {
                weather.forecasts.slice(0, 5).forEach(day => {
                    const item = document.createElement('div');
                    item.className = 'weather-forecast-day';
                    item.innerHTML = `
                        <span class="weather-forecast-day-name">${day.day}</span>
                        <i class="bi ${getWeatherIcon(day.condition)} weather-forecast-day-icon"></i>
                        <span class="weather-forecast-day-temp">${day.low}° / ${day.high}°</span>
                        <span class="weather-forecast-day-condition">${day.condition}</span>`;
                    forecastEl.appendChild(item);
                });
            }
        }

                function resetWeatherPanel() {
            document.getElementById('weatherContent').style.display = 'none';
            document.getElementById('weatherForecast').innerHTML = '';
            document.getElementById('weatherEmptyState').style.display = 'flex';
        }

                function getWeatherIcon(condition) {
            const key = (condition || '').toLowerCase().trim();

            const iconMap = {
                'sunny': 'bi-sun-fill',
                'clear': 'bi-sun-fill',
                'cloudy': 'bi-cloud-fill',
                'partly cloudy': 'bi-cloud-sun-fill',
                'overcast': 'bi-clouds-fill',
                'rain': 'bi-cloud-rain-fill',
                'light rain': 'bi-cloud-drizzle-fill',
                'drizzle': 'bi-cloud-drizzle-fill',
                'snow': 'bi-cloud-snow-fill',
                'thunderstorm': 'bi-cloud-lightning-rain-fill',
                'mist': 'bi-cloud-haze2-fill',
                'fog': 'bi-cloud-fog2-fill',
                'smoke': 'bi-cloud-haze-fill',
                'haze': 'bi-cloud-haze-fill'
            };

            if (iconMap[key]) return iconMap[key];

            for (const mapKey in iconMap) {
                if (key.includes(mapKey)) return iconMap[mapKey];
            }

            return 'bi-cloud-sun-fill';
        }

        function addAIMessage(text, meta) {
            const now = new Date().toLocaleTimeString('az-AZ', { hour:'2-digit', minute:'2-digit' });
            const div = document.createElement('div');
            div.className = 'msg-ai fade-in';
            const modelInfo = meta ? ` · ${meta.model || 'llama-3.1-8b-instant'}` : '';
            div.innerHTML = `
                <div class="msg-avatar"><i class="bi bi-robot"></i></div>
                <div>
                    <div class="msg-bubble">${renderMarkdown(text)}</div>
                    <div class="msg-ai-meta">
                        <i class="bi bi-stars me-1"></i>AI Səyahət Köməkçisi · ${now}${modelInfo}
                    </div>
                </div>`;
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

               async function sendMessage() {
            const text = promptInput.value.trim();
            if (!text || isLoading) return;

            emptyEl.style.display = 'none';
            messagesEl.style.display = 'flex';

            isLoading = true;
            sendBtn.classList.add('loading');
            sendBtn.disabled = true;

            addUserMessage(text);
            promptInput.value = '';
            promptInput.dispatchEvent(new Event('input'));

            showAgentActivity();
            showTypingIndicator();

            try {
                const response = await fetch('/Agent/AskAgent', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ prompt: text })
                });

                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const data = await response.json();

                removeTypingIndicator();

                if (data.isSuccess && data.response) {
                    completeAgentActivity();
                    addAIMessage(data.response, { model: data.model });

                    if (data.intent === 'Weather' && data.weather) {
                        updateWeatherPanel(data.weather);
                    }
                } else {
                    completeAgentActivity();
                    addAIMessage('Üzr istəyirik, xəta baş verdi. Zəhmət olmasa yenidən cəhd edin.', null);
                }

            } catch (err) {
                removeTypingIndicator();
                completeAgentActivity();
                addAIMessage(`Bağlantı xətası: ${err.message}. Zəhmət olmasa internet bağlantınızı yoxlayın.`, null);
                console.error('Agent API xətası:', err);
            } finally {
                isLoading = false;
                sendBtn.classList.remove('loading');
                sendBtn.disabled = false;
                promptInput.focus();
                setTimeout(resetAgentActivity, 3000);
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
