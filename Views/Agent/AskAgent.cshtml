            <button class="topbar-btn"><i class="bi bi-person-circle"></i> Hesabım</button>
        </div>
    </nav>

    <div class="page-shell">

        <section class="hero">
            <div class="hero-glow"></div>
            <div class="hero-eyebrow">
                <span class="hero-eyebrow-dot"></span>
                llama-3.1-8b-instant dəstəkli · Real vaxt cavablar
            </div>
            <h1 class="hero-title">
                <span class="hero-title-accent">Süni İntellekt</span><br>Səyahət Köməkçisi
            </h1>
            <p class="hero-sub">
                Gedəcəyiniz şəhər, restoranlar, gəzməli yerlər, nəqliyyat və səyahət planlaması ilə bağlı istədiyiniz sualı mənə verə bilərsiniz.
            </p>
            <div class="chip-row">
                <span class="chip" onclick="insertChip('Restoran tap:')"><i class="bi bi-cup-hot-fill"></i>Restoran Tap</span>
                <span class="chip" onclick="insertChip('Gəzməli yerlər:')"><i class="bi bi-binoculars-fill"></i>Gəzməli Yerlər</span>
                <span class="chip" onclick="insertChip('Səyahət planla:')"><i class="bi bi-airplane-fill"></i>Səyahət Planla</span>
                <span class="chip" onclick="insertChip('Nəqliyyat seçimləri:')"><i class="bi bi-train-front-fill"></i>Nəqliyyat</span>
                <span class="chip" onclick="insertChip('Yerli kafelər:')"><i class="bi bi-cup-straw"></i>Yerli Kafelər</span>
                <span class="chip" onclick="insertChip('Ailə aktivlikləri:')"><i class="bi bi-people-fill"></i>Ailə Aktivlikləri</span>
            </div>
            <div class="hero-horizon"></div>
        </section>

        <div class="main-content">

            <div class="main-left">

                <div class="prompt-card fade-in">
                    <div class="prompt-card-label">
                        <span class="prompt-card-label-dot"></span>
                        Səyahət sualınızı verin
                    </div>
                    <textarea id="promptInput"
                              asp-for="Prompt"
                              class="prompt-textarea"
                              rows="3"
                              placeholder="Səyahətiniz haqqında bir sual verin..."
                              onkeydown="handleKeydown(event)"></textarea>
                    <div class="prompt-examples">
                        <span class="prompt-examples-label">Nümunə:</span>
                        <span class="prompt-example" onclick="setPrompt('Bakıda uşaqlı ailə üçün ən yaxşı hamburgerçi məkanları hansılardır?')">
                            <i class="bi bi-lightning-fill"></i>Bakıda uşaqlı hamburgerçi
                        </span>
                        <span class="prompt-example" onclick="setPrompt('Romada 3 günlük səyahət planı hazırla, mütləq görülməli yerləri əlavə et')">
                            <i class="bi bi-lightning-fill"></i>Romada 3 günlük plan
                        </span>
                        <span class="prompt-example" onclick="setPrompt('İstanbuldan Milanoya hava limanı nəqliyyat variantları hansılardır?')">
                            <i class="bi bi-lightning-fill"></i>İstanbul–Milan nəqliyyatı
                        </span>
                    </div>
                    <div class="prompt-footer">
                        <button type="button" class="prompt-icon-btn" title="Fayl əlavə et"
                                onclick="showToast('Fayl əlavə etmə tezliklə aktiv olacaq')">
                            <i class="bi bi-paperclip"></i>
                        </button>
                        <button type="button" class="prompt-icon-btn" title="Məkan əlavə et"
                                onclick="showToast('Məkan əlavə etmə tezliklə aktiv olacaq')">
                            <i class="bi bi-geo-alt-fill"></i>
                        </button>
                        <button type="button" class="prompt-icon-btn" title="Səsli giriş"
                                onclick="showToast('Səsli giriş tezliklə aktiv olacaq')">
                            <i class="bi bi-mic-fill"></i>
                        </button>
                        <span class="prompt-footer-hint" id="charCount">0 / 500</span>
                        <button type="button" class="prompt-send-btn" id="sendBtn" onclick="sendMessage()">
                            <span class="btn-spinner spinner-border spinner-border-sm" role="status"
                                  style="width:14px;height:14px;border-width:2px;"></span>
                            <i class="bi bi-send-fill"></i>
