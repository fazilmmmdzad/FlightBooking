                    <div class="panel-body" id="weatherContent" style="display:none;">
                        <div class="weather-main">
                            <div class="weather-location">
                                <div class="weather-city" id="weatherCity"></div>
                                <div class="weather-country" id="weatherCountry"></div>
                            </div>
                            <div class="weather-temp-row">
                                <div class="weather-icon" id="weatherIcon"><i class="bi bi-cloud-sun-fill"></i></div>
                                <div class="weather-temp" id="weatherTemp"></div>
                            </div>
                            <div class="weather-condition" id="weatherCondition"></div>
                        </div>
                        <div class="weather-stats">
                            <div class="weather-stat">
