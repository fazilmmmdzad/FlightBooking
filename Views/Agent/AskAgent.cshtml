                            <div class="cep" onclick="setPrompt('İstanbuldan Milanoya gedən biri üçün hava limanı nəqliyyat variantları hansılardır?')">
                                <i class="bi bi-train-front-fill"></i>
                                İstanbuldan Milanoya hava limanı nəqliyyatı tövsiyə et
                            </div>
                            <div class="cep" onclick="setPrompt('Kadıköydə həftə sonu ailəyə uyğun yemək məkanları və aktivliklər hansılardır?')">
                                <i class="bi bi-people-fill"></i>
                                Kadıköydə həftə sonu ailəyə uyğun məkanlar tap
                            </div>
                        </div>
                    </div>

                    <div class="convo-messages" id="messages" style="display:none;"></div>
                </div>

            </div>

            <div class="right-panel">
                <div class="glass-card slide-up" id="weatherCard" style="animation-delay:.1s;">
                    <div class="panel-head">
                        <div class="panel-head-ico" style="background:#ecfeff;color:#0891b2;"><i class="bi bi-cloud-sun-fill"></i></div>
                        <div>
                            <div class="panel-head-title">Hava Şəraiti</div>
