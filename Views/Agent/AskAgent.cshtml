                        </div>
                        <div class="activity-step" id="step-4">
                            <div class="activity-step-ico"><i class="bi bi-check-lg"></i></div>
                            <span>Cavab Gözlənilir</span>
                        </div>
                        <div class="activity-step" id="step-5">
                            <div class="activity-step-ico"><i class="bi bi-check-lg"></i></div>
                            <span>Cavab Alındı</span>
                        </div>
                    </div>
                </div>

                <div class="convo-area fade-in" id="convoArea" style="animation-delay:.14s;">
                    <div class="convo-header">
                        <div class="convo-header-ico"><i class="bi bi-robot"></i></div>
                        <div>
                            <div class="convo-header-title">Səyahət Köməkçisi</div>
                            <div class="convo-header-sub">Səyahətiniz üçün fərdiləşdirilmiş</div>
