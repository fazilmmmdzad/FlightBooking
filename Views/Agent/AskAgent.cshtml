@model FlightBooking.Dtos.AgentDtos.AgentPromptRequestDto

@{
    ViewData["Title"] = "AI Səyahət Köməkçisi";
    Layout = null;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Səyahət Köməkçisi · FlightBooking</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet" />
    <link rel="shortcut icon" type="image/x-icon" href="/geair/assets/img/favicon.png">

    <style>
        :root {
            --navy: #0B1120;
            --navy-80: #1E293B;
            --indigo: #6D5AE6;
            --indigo-bg: #F1EEFF;
            --violet: #8B5CF6;
            --cyan: #22D3EE;
            --cyan-bg: #ECFEFF;
            --amber: #F59E0B;
            --amber-bg: #FFFBEB;
            --slate-100: #F4F5FA;
            --slate-200: #E4E6F1;
            --slate-300: #CBD0E3;
            --slate-400: #9AA1BD;
            --slate-500: #6B7290;
            --slate-600: #454B69;
            --font-display: 'Syne', sans-serif;
            --font-body: 'DM Sans', sans-serif;
            --radius-xl: 26px;
            --radius-lg: 20px;
            --radius-md: 14px;
            --radius-sm: 10px;
            --shadow-sm: 0 1px 4px rgba(15,23,42,.06);
            --shadow-md: 0 6px 24px rgba(31,25,90,.10);
            --shadow-lg: 0 16px 56px rgba(31,25,90,.16);
            --shadow-glow: 0 0 0 4px rgba(109,90,230,.10);
        }

        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: radial-gradient(circle at 12% 0%, #EFEBFF 0%, #F7F8FC 38%, #F7F8FC 100%);
            font-family: var(--font-body);
            color: var(--navy);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            height: 60px;
            background: rgba(255,255,255,.78);
            backdrop-filter: blur(16px) saturate(140%);
            -webkit-backdrop-filter: blur(16px) saturate(140%);
            border-bottom: 1px solid rgba(228,230,241,.8);
            display: flex;
            align-items: center;
            padding: 0 24px;
            gap: 16px;
        }

        .topbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: var(--font-display);
            font-size: 15px;
            font-weight: 700;
            color: var(--navy);
            text-decoration: none;
        }

        .topbar-brand-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg,var(--indigo),var(--violet) 55%,var(--cyan));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 15px;
            box-shadow: 0 4px 14px rgba(109,90,230,.35);
        }

        .topbar-badge {
            padding: 3px 11px;
            border-radius: 99px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .3px;
            background: linear-gradient(135deg,var(--indigo-bg),var(--cyan-bg));
            color: var(--indigo);
            border: 1px solid #DCD5FF;
            margin-left: 4px;
        }

        .topbar-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .topbar-link {
            font-size: 13px;
            font-weight: 500;
            color: var(--slate-600);
            text-decoration: none;
            padding: 6px 13px;
            border-radius: var(--radius-sm);
            transition: background .15s, color .15s;
        }

            .topbar-link:hover {
                background: var(--slate-100);
                color: var(--navy);
            }

        .topbar-btn {
            padding: 8px 17px;
            border-radius: var(--radius-sm);
            background: var(--navy);
            color: white;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all .15s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .topbar-btn:hover {
                background: #1a2440;
                box-shadow: 0 4px 14px rgba(11,17,32,.25);
            }

        .page-shell {
            padding-top: 60px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .hero {
            position: relative;
            padding: 64px 24px 48px;
            text-align: center;
            overflow: hidden;
        }

        .hero-horizon {
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 2px;
            background: linear-gradient(90deg,transparent 0%,var(--indigo) 25%,var(--cyan) 50%,var(--violet) 75%,transparent 100%);
            border-radius: 99px;
            animation: horizon-shimmer 4s ease-in-out infinite;
        }

        @@keyframes horizon-shimmer {
            0%, 100% {
                opacity: .6;
                width: 400px;
            }

            50% {
                opacity: 1;
                width: 680px;
            }
        }

        .hero-glow {
            position: absolute;
            top: -80px;
            left: 50%;
            transform: translateX(-50%);
            width: 560px;
            height: 320px;
            background: radial-gradient(ellipse at center,rgba(109,90,230,.14) 0%,rgba(34,211,238,.07) 50%,transparent 80%);
            pointer-events: none;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 17px;
            border-radius: 99px;
            background: white;
            border: 1px solid var(--slate-200);
            box-shadow: var(--shadow-sm);
            font-size: 12px;
            font-weight: 600;
            color: var(--slate-600);
            margin-bottom: 20px;
        }

            .hero-eyebrow i {
                color: var(--indigo);
                font-size: 12px;
            }

        .hero-eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: linear-gradient(135deg,var(--indigo),var(--cyan));
            animation: pulse-glow 2s ease-in-out infinite;
            flex-shrink: 0;
        }

        @@keyframes pulse-glow {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(109,90,230,.4);
            }

            50% {
                box-shadow: 0 0 0 5px rgba(109,90,230,.0);
            }
        }

        .hero-title {
            font-family: var(--font-display);
            font-size: clamp(30px,5vw,50px);
            font-weight: 800;
            color: var(--navy);
            letter-spacing: -.03em;
            line-height: 1.1;
            margin-bottom: 14px;
        }

        .hero-title-accent {
            background: linear-gradient(135deg,var(--indigo) 0%,var(--violet) 55%,var(--cyan) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: 15px;
            line-height: 1.65;
            color: var(--slate-500);
            font-weight: 400;
            max-width: 500px;
            margin: 0 auto 26px;
        }

        .chip-row {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 9px;
            max-width: 660px;
            margin: 0 auto;
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 16px;
            border-radius: 99px;
            background: white;
            border: 1.5px solid var(--slate-200);
            font-size: 13px;
            font-weight: 500;
            color: var(--slate-600);
            cursor: pointer;
            transition: all .15s;
            box-shadow: var(--shadow-sm);
            user-select: none;
        }

            .chip i {
                font-size: 13px;
                color: var(--indigo);
            }

            .chip:hover {
                border-color: var(--indigo);
                background: var(--indigo-bg);
                color: var(--indigo);
                transform: translateY(-1px);
                box-shadow: 0 4px 12px rgba(109,90,230,.18);
            }

        .main-content {
            flex: 1;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            padding: 0 24px 60px;
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 24px;
            align-items: start;
        }

        .main-left {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .prompt-card {
            background: white;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-md);
            padding: 22px;
            transition: border-color .2s,box-shadow .2s;
        }

            .prompt-card:focus-within {
                border-color: var(--indigo);
                box-shadow: var(--shadow-glow),var(--shadow-md);
            }

        .prompt-card-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: var(--slate-400);
            margin-bottom: 10px;
        }

        .prompt-card-label-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: linear-gradient(135deg,var(--indigo),var(--cyan));
            flex-shrink: 0;
        }

        .prompt-textarea {
            width: 100%;
            border: none;
            outline: none;
            resize: none;
            font-family: var(--font-body);
            font-size: 15px;
            line-height: 1.6;
            color: var(--navy);
            background: transparent;
            min-height: 90px;
            padding: 0;
        }

            .prompt-textarea::placeholder {
                color: var(--slate-400);
                font-weight: 400;
            }

        .prompt-examples {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            padding: 10px 0;
            border-top: 1px solid var(--slate-100);
            border-bottom: 1px solid var(--slate-100);
            margin: 10px 0;
            align-items: center;
        }

        .prompt-examples-label {
            font-size: 10px;
            font-weight: 700;
            color: var(--slate-400);
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-right: 4px;
            white-space: nowrap;
        }

        .prompt-example {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 8px;
            background: var(--slate-100);
            font-size: 11.5px;
            color: var(--slate-500);
            cursor: pointer;
            transition: all .13s;
        }

            .prompt-example:hover {
                background: var(--indigo-bg);
                color: var(--indigo);
            }

        .prompt-footer {
            display: flex;
            align-items: center;
            gap: 8px;
            padding-top: 10px;
        }

        .prompt-icon-btn {
            width: 38px;
            height: 38px;
            border-radius: var(--radius-sm);
            border: 1.5px solid var(--slate-200);
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: var(--slate-500);
            cursor: pointer;
            transition: all .13s;
            flex-shrink: 0;
        }

            .prompt-icon-btn:hover {
                border-color: var(--indigo);
                color: var(--indigo);
                background: var(--indigo-bg);
            }

        .prompt-footer-hint {
            font-size: 11.5px;
            color: var(--slate-400);
            margin-left: auto;
            margin-right: 8px;
        }

        .prompt-send-btn {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 10px 24px;
            border-radius: var(--radius-sm);
            background: linear-gradient(135deg,var(--indigo) 0%,var(--violet) 100%);
            color: white;
            border: none;
            cursor: pointer;
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 600;
            transition: all .15s;
            box-shadow: 0 6px 18px rgba(109,90,230,.35);
            flex-shrink: 0;
        }

            .prompt-send-btn:hover {
                background: linear-gradient(135deg,#5a47d6,#7c4de0);
                box-shadow: 0 8px 24px rgba(109,90,230,.45);
                transform: translateY(-1px);
            }

            .prompt-send-btn:active {
                transform: translateY(0);
            }

            .prompt-send-btn:disabled {
                opacity: .65;
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }

            .prompt-send-btn .btn-spinner {
                display: none;
            }

            .prompt-send-btn.loading .bi-send-fill {
                display: none;
            }

            .prompt-send-btn.loading .btn-spinner {
                display: inline-block;
            }

        .quick-cards {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
        }

        .quick-card {
            background: white;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-md);
            padding: 17px 15px;
            cursor: pointer;
            transition: all .18s;
            display: flex;
            flex-direction: column;
            gap: 10px;
            box-shadow: var(--shadow-sm);
            position: relative;
            overflow: hidden;
        }

            .quick-card::before {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 2px;
                border-radius: 0 0 var(--radius-md) var(--radius-md);
                opacity: 0;
                transition: opacity .18s;
            }

            .quick-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-md);
                border-color: transparent;
            }

                .quick-card:hover::before {
                    opacity: 1;
                }

        .qc-food::before {
            background: linear-gradient(90deg,var(--amber),#fb923c);
        }

        .qc-attraction::before {
            background: linear-gradient(90deg,var(--indigo),var(--cyan));
        }

        .qc-hotel::before {
            background: linear-gradient(90deg,var(--violet),var(--indigo));
        }

        .qc-transport::before {
            background: linear-gradient(90deg,var(--cyan),#10b981);
        }

        .qc-food:hover {
            background: #fffdf8;
        }

        .qc-attraction:hover {
            background: var(--indigo-bg);
        }

        .qc-hotel:hover {
            background: #faf5ff;
        }

        .qc-transport:hover {
            background: var(--cyan-bg);
        }

        .quick-card-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .qc-food .quick-card-icon {
            background: var(--amber-bg);
            color: var(--amber);
        }

        .qc-attraction .quick-card-icon {
            background: var(--indigo-bg);
            color: var(--indigo);
        }

        .qc-hotel .quick-card-icon {
            background: #f5f3ff;
            color: var(--violet);
        }

        .qc-transport .quick-card-icon {
            background: var(--cyan-bg);
            color: #0891b2;
        }

        .quick-card-title {
            font-family: var(--font-display);
            font-size: 13px;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: 2px;
        }

        .quick-card-desc {
            font-size: 11.5px;
            color: var(--slate-500);
            line-height: 1.45;
        }

        .quick-card-arrow {
            margin-top: auto;
            font-size: 13px;
            color: var(--slate-400);
            transition: color .15s,transform .15s;
        }

        .quick-card:hover .quick-card-arrow {
            color: var(--indigo);
            transform: translateX(3px);
        }

        .agent-activity {
            background: white;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            display: none;
        }

            .agent-activity.visible {
                display: block;
                animation: fadeIn .25s ease;
            }

        .activity-head {
            padding: 12px 16px;
            border-bottom: 1px solid var(--slate-100);
            display: flex;
            align-items: center;
            gap: 8px;
            background: #FAFAFE;
        }

        .activity-head-ico {
            width: 27px;
            height: 27px;
            border-radius: 8px;
            background: linear-gradient(135deg,var(--indigo),var(--cyan));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
        }

        .activity-head-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--navy);
        }

        .activity-head-badge {
            margin-left: auto;
            padding: 3px 10px;
            border-radius: 99px;
            font-size: 10.5px;
            font-weight: 600;
            background: var(--indigo-bg);
            color: var(--indigo);
            border: 1px solid #DCD5FF;
        }

        .activity-steps {
            padding: 12px 16px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .activity-step {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--slate-500);
            transition: color .2s;
        }

        .activity-step-ico {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 1.5px solid var(--slate-300);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            color: var(--slate-400);
            flex-shrink: 0;
            transition: all .2s;
        }

        .activity-step.done .activity-step-ico {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #16a34a;
        }

        .activity-step.done {
            color: var(--navy);
        }

        .activity-step.active .activity-step-ico {
            background: var(--indigo-bg);
            border-color: #DCD5FF;
            color: var(--indigo);
            animation: spin .8s linear infinite;
        }

        .activity-step.active {
            color: var(--indigo);
            font-weight: 600;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .convo-area {
            background: white;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-sm);
            min-height: 360px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .convo-header {
            padding: 14px 19px;
            border-bottom: 1px solid var(--slate-100);
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FAFAFE;
            flex-shrink: 0;
        }

        .convo-header-ico {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: linear-gradient(135deg,var(--indigo),var(--violet) 55%,var(--cyan));
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 13px;
        }

        .convo-header-title {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--navy);
        }

        .convo-header-sub {
            font-size: 11px;
            color: var(--slate-400);
        }

        .convo-header-badge {
            margin-left: auto;
            padding: 3px 10px;
            border-radius: 99px;
            background: #f0fdf4;
            color: #16a34a;
            font-size: 11px;
            font-weight: 600;
            border: 1px solid #bbf7d0;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .convo-header-badge::before {
                content: '';
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #16a34a;
                flex-shrink: 0;
                animation: pulse-green 2s ease-in-out infinite;
            }

        @@keyframes pulse-green {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: .3;
            }
        }

        .convo-empty {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 24px;
            text-align: center;
        }

        .convo-empty-globe {
            width: 78px;
            height: 78px;
            border-radius: 24px;
            background: linear-gradient(135deg,var(--indigo-bg) 0%,var(--cyan-bg) 100%);
            border: 2px dashed var(--slate-200);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: var(--indigo);
            margin-bottom: 18px;
            position: relative;
        }

            .convo-empty-globe::after {
                content: '\F287';
                font-family: 'bootstrap-icons';
                position: absolute;
                top: -8px;
                right: -8px;
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: white;
                border: 1.5px solid var(--slate-200);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                color: var(--cyan);
            }

        .convo-empty-title {
            font-family: var(--font-display);
            font-size: 16px;
            font-weight: 700;
            color: var(--navy);
            margin-bottom: 6px;
        }

        .convo-empty-sub {
            font-size: 13px;
            color: var(--slate-400);
            max-width: 260px;
            line-height: 1.6;
            margin-bottom: 22px;
        }

        .convo-empty-prompts {
            display: flex;
            flex-direction: column;
            gap: 7px;
            width: 100%;
            max-width: 340px;
        }

        .cep {
            padding: 11px 15px;
            background: var(--slate-100);
            border-radius: var(--radius-sm);
            font-size: 12.5px;
            color: var(--slate-600);
            cursor: pointer;
            transition: all .13s;
            text-align: left;
            border: 1px solid transparent;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .cep i {
                color: var(--indigo);
                font-size: 13px;
                flex-shrink: 0;
            }

            .cep:hover {
                background: var(--indigo-bg);
                border-color: #DCD5FF;
                color: var(--indigo);
            }

        .convo-messages {
            flex: 1;
            padding: 18px 19px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            overflow-y: auto;
            max-height: 500px;
        }

        .msg-user, .msg-ai {
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .msg-user {
            flex-direction: row-reverse;
        }

        .msg-avatar {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .msg-ai .msg-avatar {
            background: linear-gradient(135deg,var(--indigo),var(--violet) 55%,var(--cyan));
            color: white;
        }

        .msg-user .msg-avatar {
            background: var(--navy);
            color: white;
        }

        .msg-bubble {
            max-width: 82%;
            padding: 12px 16px;
            border-radius: 16px;
            font-size: 13.5px;
            line-height: 1.65;
        }

        .msg-user .msg-bubble {
            background: var(--navy);
            color: white;
            border-radius: 16px 4px 16px 16px;
        }

        .msg-ai .msg-bubble {
            background: #FAFAFE;
            color: var(--navy);
            border: 1.5px solid var(--slate-200);
            border-radius: 4px 16px 16px 16px;
            box-shadow: var(--shadow-sm);
        }

            .msg-ai .msg-bubble p {
                margin: 0 0 8px;
            }

                .msg-ai .msg-bubble p:last-child {
                    margin-bottom: 0;
                }

            .msg-ai .msg-bubble ul,
            .msg-ai .msg-bubble ol {
                padding-left: 20px;
                margin: 8px 0;
            }

            .msg-ai .msg-bubble li {
                margin-bottom: 4px;
            }

            .msg-ai .msg-bubble strong {
                font-weight: 700;
                color: var(--navy-80);
            }

            .msg-ai .msg-bubble hr {
                border: none;
                border-top: 1px solid var(--slate-200);
                margin: 10px 0;
            }

        .msg-ai-meta {
            font-size: 10.5px;
            color: var(--slate-400);
            margin-top: 5px;
            padding-left: 2px;
        }

        .msg-typing {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 12px 15px;
            background: #FAFAFE;
            border: 1.5px solid var(--slate-200);
            border-radius: 4px 16px 16px 16px;
            box-shadow: var(--shadow-sm);
        }

        .typing-text {
            font-size: 12px;
            color: var(--slate-400);
            margin-left: 2px;
        }

        .typing-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--indigo);
            animation: typing-bounce .8s ease-in-out infinite;
        }

            .typing-dot:nth-child(2) {
                animation-delay: .15s;
            }

            .typing-dot:nth-child(3) {
                animation-delay: .3s;
            }

        @@keyframes typing-bounce {
            0%, 80%, 100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-5px);
            }
        }

        .right-panel {
            display: flex;
            flex-direction: column;
            gap: 14px;
            position: sticky;
            top: 76px;
        }

        .glass-card {
            background: rgba(255,255,255,.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1.5px solid rgba(255,255,255,.9);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }

        .panel-head {
            padding: 13px 16px 10px;
            border-bottom: 1px solid var(--slate-100);
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(250,250,254,.9);
        }

        .panel-head-ico {
            width: 29px;
            height: 29px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
        }

        .panel-head-title {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--navy);
        }

        .panel-head-sub {
            font-size: 10.5px;
            color: var(--slate-400);
        }

        .panel-body {
            padding: 14px 16px;
        }

        .panel-empty-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 22px 16px;
            min-height: 96px;
        }

        .panel-empty-ico {
            font-size: 24px;
            margin-bottom: 10px;
            color: var(--slate-300);
        }

        .panel-empty-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--slate-600);
            margin-bottom: 4px;
        }

        .panel-empty-desc {
            font-size: 11.5px;
            color: var(--slate-400);
            line-height: 1.5;
        }

        .page-footer {
            border-top: 1px solid var(--slate-200);
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: var(--slate-400);
            flex-wrap: wrap;
            gap: 8px;
            background: white;
        }

        .footer-left {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .footer-link {
            color: var(--slate-400);
            text-decoration: none;
        }

            .footer-link:hover {
                color: var(--indigo);
            }

        .footer-powered {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 5px 13px;
            border-radius: 99px;
            background: linear-gradient(135deg,var(--indigo-bg),var(--cyan-bg));
            color: var(--indigo);
            font-size: 11.5px;
            font-weight: 600;
            border: 1px solid #DCD5FF;
        }

        .fade-in {
            animation: fadeIn .35s ease forwards;
        }

        .weather-main {
            padding-bottom: 12px;
            border-bottom: 1px solid var(--slate-100);
            margin-bottom: 12px;
        }

        .weather-city {
            font-family: var(--font-display);
            font-size: 15px;
            font-weight: 700;
            color: var(--navy);
        }

        .weather-country {
            font-size: 11px;
            color: var(--slate-400);
            margin-bottom: 8px;
        }

        .weather-temp-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .weather-icon {
            font-size: 26px;
            color: var(--indigo);
        }

        .weather-temp {
            font-family: var(--font-display);
            font-size: 30px;
            font-weight: 800;
            color: var(--navy);
        }

        .weather-condition {
            font-size: 12.5px;
            color: var(--slate-500);
            margin-top: 2px;
        }

        .weather-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 12px;
        }

        .weather-stat {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11.5px;
        }

            .weather-stat i {
                color: var(--indigo);
                font-size: 13px;
                width: 16px;
                text-align: center;
            }

        .weather-stat-label {
            color: var(--slate-400);
            font-size: 10.5px;
        }

        .weather-stat-value {
            color: var(--navy);
            font-weight: 600;
        }

        .weather-forecast {
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding-top: 12px;
            border-top: 1px solid var(--slate-100);
        }

        .weather-forecast-day {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 8px;
            border-radius: var(--radius-sm);
            background: var(--slate-100);
            font-size: 11.5px;
        }

        .weather-forecast-day-name {
            flex: 0 0 46px;
            font-weight: 600;
            color: var(--navy);
        }

        .weather-forecast-day-icon {
            color: var(--indigo);
            font-size: 14px;
            width: 18px;
            text-align: center;
        }

        .weather-forecast-day-temp {
            color: var(--slate-600);
            font-weight: 600;
        }

        .weather-forecast-day-condition {
            margin-left: auto;
            color: var(--slate-400);
            font-size: 10.5px;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .slide-up {
            animation: slideUp .4s ease forwards;
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .toast-bar {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            background: var(--navy);
            color: white;
            padding: 12px 18px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 500;
            box-shadow: var(--shadow-lg);
            opacity: 0;
            transform: translateY(8px);
            transition: all .25s;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        @@media (max-width:1024px) {
            .main-content {
                grid-template-columns: 1fr;
            }

            .right-panel {
                position: static;
                display: grid;
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width:768px) {
            .main-content {
                padding: 0 16px 48px;
            }

            .hero {
                padding: 36px 16px 32px;
            }

            .quick-cards {
                grid-template-columns: repeat(2,1fr);
            }

            .right-panel {
                grid-template-columns: 1fr;
            }

            .topbar-link {
                display: none;
            }

            .hero-title {
                font-size: 26px;
            }
        }

        @@media (max-width:480px) {
            .quick-cards {
                grid-template-columns: 1fr 1fr;
            }

            .chip {
                font-size: 12px;
                padding: 6px 13px;
            }
        }

        @@media (prefers-reduced-motion:reduce) {
            .hero-horizon, .hero-eyebrow-dot, .typing-dot, .fade-in, .slide-up {
                animation: none !important;
            }
        }
    </style>
</head>
<body>

    <nav class="topbar">
        <a href="/" class="topbar-brand">
            <div class="topbar-brand-icon"><i class="bi bi-airplane-fill"></i></div>
            FlightBooking
