        </button>
        <div class="dropdown-menu-custom" id="notif-dd">
            <div style="padding:8px 12px 6px;font-size:11px;font-weight:700;color:var(--gray-500);letter-spacing:.6px;text-transform:uppercase;">Bildirişlər</div>
            <a href="#" onclick="return false;"><i class="bi bi-exclamation-triangle-fill" style="color:#F59E0B;"></i>AZ330 gecikir – 45 dəq</a>
            <a href="#" onclick="return false;"><i class="bi bi-x-circle-fill" style="color:#EF4444;"></i>AZ450 ləğv edildi</a>
