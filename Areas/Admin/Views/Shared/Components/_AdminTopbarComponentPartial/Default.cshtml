            <a href="#" onclick="return false;" style="justify-content:center;color:var(--accent);font-weight:600;">Hamısına Bax</a>
        </div>
    </div>


    <div class="dd-wrapper">
        <button class="tb-icon-btn" onclick="toggleDD('msg-dd')">
            <i class="bi bi-chat-fill"></i>
