            <a href="#" onclick="return false;" style="justify-content:center;color:var(--accent);font-weight:600;">Bütün Mesajlar</a>
        </div>
    </div>

    <div class="dd-wrapper">
        <button class="user-pill" onclick="toggleDD('user-dd')">
            <div class="user-avatar">FM</div>
            <div class="user-info">
                <span class="user-name">Fazil Məmmədzadə</span>
