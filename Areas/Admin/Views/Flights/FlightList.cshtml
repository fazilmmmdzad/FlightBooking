                    <a class="sub-menu-link" href="#" onclick="return false;"><i class="bi bi-dot"></i>Köşk İdarəetməsi</a>
                </div>
            </div>


            <div class="nav-label">ANALİTİKA</div>

            <div class="nav-item-wrap">
