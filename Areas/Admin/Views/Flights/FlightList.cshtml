                <div class="stat-icon red"><i class="bi bi-x-circle-fill"></i></div>
                <div class="stat-body">
                    <div class="stat-value">14</div>
                    <div class="stat-label">Ləğv Edilən</div>
                    <div class="stat-change up"><i class="bi bi-arrow-down-short"></i>-2 keçən ay</div>
                </div>
            </div>
        </div>

        <div class="table-card">

            <div class="table-card-header">
                <div class="tbl-search">
                    <i class="bi bi-search si"></i>
                    <input type="text" id="searchInput" placeholder="Uçuş nömrəsi, şəhər və ya status axtar..." oninput="filterTable()" />
                </div>

