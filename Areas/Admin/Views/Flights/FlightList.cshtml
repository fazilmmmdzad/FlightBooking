@{
    Layout = "~/Areas/Admin/Views/Layout/AdminLayout.cshtml";
}

<main class="main-content" id="main-content">

    <div class="page-header">
        <div class="page-title-group">
            <div class="page-breadcrumb">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
                <i class="bi bi-chevron-right sep"></i>
                <span style="color:var(--accent);">Flights Management</span>
            </div>
            <h1 class="page-title">Flights Management</h1>
            <p class="page-desc">Sistemdə qeydiyyatda olan uçuşları görüntüləyə, redaktə edə və ya yeni uçuş əlavə edə bilərsiniz.</p>
        </div>
        <button class="btn-add" onclick="openModal()">
            <i class="bi bi-plus-lg"></i>
            <span>Yeni Uçuş Əlavə Et</span>
        </button>
    </div>

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="bi bi-airplane-fill"></i></div>
            <div class="stat-body">
                <div class="stat-value">248</div>
                <div class="stat-label">Ümumi Uçuş</div>
                <div class="stat-change up"><i class="bi bi-arrow-up-short"></i>+12 bu həftə</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-body">
                <div class="stat-value">192</div>
                <div class="stat-label">Tamamlanan</div>
                <div class="stat-change up"><i class="bi bi-arrow-up-short"></i>%77 nisbət</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange"><i class="bi bi-clock-fill"></i></div>
            <div class="stat-body">
                <div class="stat-value">31</div>
                <div class="stat-label">Gecikir</div>
                <div class="stat-change down"><i class="bi bi-arrow-up-short"></i>+3 dünən</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red"><i class="bi bi-x-circle-fill"></i></div>
            <div class="stat-body">
                <div class="stat-value">14</div>
                <div class="stat-label">Ləğv Edilən</div>
                <div class="stat-change up"><i class="bi bi-arrow-down-short"></i>-2 keçən ay</div>
            </div>
        </div>
    </div>

    <div class="table-card">

        <div class="table-card-header">
            <div class="tbl-search">
                <i class="bi bi-search si"></i>
                <input type="text" id="searchInput" placeholder="Uçuş nömrəsi, şəhər və ya status axtar..." oninput="filterTable()" />
            </div>

            <select class="filter-select" id="statusFilter" onchange="filterTable()">
                <option value="">Bütün Statuslar</option>
                <option value="Boarding">Boarding</option>
                <option value="Planlaşdırılıb">Planlaşdırılıb</option>
                <option value="Gecikir">Gecikir</option>
                <option value="Ləğv edildi">Ləğv edildi</option>
            </select>

            <select class="filter-select" id="cityFilter" onchange="filterTable()">
                <option value="">Bütün Şəhərlər</option>
                <option value="İstanbul">Bakı</option>
                <option value="Paris">Paris</option>
                <option value="Roma">Roma</option>
                <option value="Londra">Londra</option>
                <option value="Berlin">Berlin</option>
                <option value="Amsterdam">Amsterdam</option>
                <option value="Madrid">Madrid</option>
                <option value="Frankfurt">Frankfurt</option>
            </select>

            <span class="tbl-count" id="rowCount">10 uçuş göstərilir</span>
        </div>

        <div style="overflow-x:auto;">
            <table class="flights-table" id="flightsTable">
                <thead>
                    <tr>
                        <th>UÇUŞ NO</th>
                        <th>MARŞRUT</th>
                        <th>QALXIŞ</th>
                        <th>ENİŞ</th>
                        <th>TƏYYARƏ MODELİ</th>
                        <th>QAPI</th>
                        <th>STATUS</th>
                        <th>ƏMƏLİYYATLAR</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                </tbody>
            </table>
        </div>


        <div class="table-card-footer">
            <span class="footer-info" id="footerInfo">1–10 / 10 uçuş</span>
            <ul class="pagination-list" id="paginationList">
            </ul>
        </div>

    </div>

</main>
