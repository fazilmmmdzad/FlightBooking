        </div>

    </main>

    <div class="modal-overlay" id="flightModal">
        <div class="modal-box">
            <div class="modal-head">
                <span class="modal-title"><i class="bi bi-airplane-fill" style="color:var(--accent);margin-right:8px;"></i>Yeni Uçuş Əlavə Et</span>
