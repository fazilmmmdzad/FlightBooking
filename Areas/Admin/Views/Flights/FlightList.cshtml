                            <option>Airbus A320</option>
                            <option>Airbus A321</option>
                            <option>Boeing 737</option>
                            <option>Boeing 777</option>
                            <option>Boeing 787</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Qalxış Şəhəri</label>
                        <input class="form-control-custom" type="text" placeholder="Bakı" id="newDep" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Eniş Şəhəri</label>
                        <input class="form-control-custom" type="text" placeholder="Paris" id="newArr" />
                    </div>
                </div>
                <div class="form-row">
